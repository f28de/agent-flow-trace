{
  "name": "agent-flow-trace-workbench",
  "version": "1.0.0",
  "type": "module",
  "penguin": {
    "version": "2026.11.06.2",
    "modules": [
      {
        "name": "Workbench",
        "requires": {
          "host": {
            "iface": "@prismshadow/penguin-server#WorkbenchHost",
            "from": "Host"
          }
        },
        "provides": {
          "main": "@prismshadow/penguin-server#WorkbenchMain"
        },
        "contributes": {
          "WebModule.sessionTabs": [
            {
              "id": "flow-trace.main",
              "key": "flow-trace",
              "title": "Flow Trace",
              "titleZh": "流转轨迹",
              "renderer": {
                "iframe": {
                  "src": "ui/index.html"
                }
              }
            }
          ]
        }
      }
    ]
  }
}
